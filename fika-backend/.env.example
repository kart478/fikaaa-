# Supabase pooled connection string for the application runtime.
DATABASE_URL="postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Supabase direct connection string for Prisma migrations and introspection.
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.<project-ref>.supabase.co:5432/postgres"
PORT=4000
NODE_ENV=development
SESSION_SECRET="replace-with-a-long-random-secret-of-32-chars"
CLIENT_URL="http://localhost:5173"
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
